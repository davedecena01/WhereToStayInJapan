# Copy this file to .env and fill in your values.
# Never commit .env to source control.
#
# SECURITY NOTE:
# This file must contain placeholders only. Do not paste real project URLs,
# anon keys, JWTs, passwords, or any value that ties back to a specific
# deployment. Even Supabase anon keys — though designed to be public when RLS
# is correctly configured — should not be checked in here, because they
# disclose the project ref and broaden the attack surface.

# =============================================================================
# Supabase
# =============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# =============================================================================
# Database (used by .NET backend via connection string)
# =============================================================================
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password

# Full connection string (alternative to individual vars above)
# CONNECTION_STRING=postgresql://postgres:your-supabase-db-password@db.your-project-ref.supabase.co:5432/postgres

# =============================================================================
# Hotel API
# =============================================================================
RAKUTEN_APPLICATION_ID=your-rakuten-app-id
RAKUTEN_AFFILIATE_ID=your-rakuten-affiliate-id

# =============================================================================
# AI Provider (set one)
# =============================================================================
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GEMINI_API_KEY=your-gemini-api-key

# =============================================================================
# Maps / Geocoding
# =============================================================================
# GEOCODING_API_KEY=your-key-if-needed
